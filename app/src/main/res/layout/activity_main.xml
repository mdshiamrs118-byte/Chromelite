<?xml version="1.0" encoding="utf-8"?>
<!--
    Root is focusableInTouchMode so the omnibox can release focus (clearFocus) and
    does not grab focus / pop up the keyboard on launch.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chrome_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- ===== Chrome-style top toolbar (slim) ===== -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chrome_toolbar"
        android:elevation="2dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="2dp">

            <!-- Omnibox: padlock + URL/title field + clear/stop/reload -->
            <LinearLayout
                android:id="@+id/omnibox"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_omnibox"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/iv_security"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/et_omnibox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:ellipsize="end"
                    android:hint="@string/omnibox_hint"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="2dp"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/chrome_text_primary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btn_omnibox_action"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_reload"
                    android:padding="7dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/chrome_text_secondary" />

            </LinearLayout>

            <!-- Profile badge: initial of the active pane's profile, in the profile's color -->
            <TextView
                android:id="@+id/tv_profile"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="0dp"
                android:background="@drawable/bg_profile_badge"
                android:clickable="true"
                android:contentDescription="@string/cd_profile"
                android:focusable="true"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Tab / pane counter -->
            <FrameLayout
                android:id="@+id/btn_tabs"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_tabs"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_tab_count"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tab_counter"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/chrome_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />
            </FrameLayout>

            <!-- Overflow menu -->
            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_more"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/chrome_text_primary" />
        </LinearLayout>

        <!-- Page load progress (shows progress of the active pane) -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:visibility="invisible"
            app:indicatorColor="@color/chrome_progress"
            app:trackColor="@android:color/transparent"
            app:trackThickness="2dp" />

    </LinearLayout>

    <!-- ===== Find in page (hidden until opened from the menu) ===== -->
    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/chrome_toolbar"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="2dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_find"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/find_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/chrome_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_find_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:textColor="@color/chrome_text_secondary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btn_find_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_previous"
            android:src="@drawable/ic_arrow_up"
            app:tint="@color/chrome_text_primary" />

        <ImageButton
            android:id="@+id/btn_find_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_next"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/chrome_text_primary" />

        <ImageButton
            android:id="@+id/btn_find_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_close"
            android:src="@drawable/ic_close"
            app:tint="@color/chrome_text_primary" />
    </LinearLayout>

    <!--
        ===== Content area =====
        The split container fills it. The show/hide-toolbar button floats over its top-left
        corner, so it sits right under the toolbar without taking a row of its own, and it
        stays reachable when the toolbar is hidden.
    -->
    <FrameLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!--
            Split container: orientation / sizes are switched in code (side by side <-> top & bottom).
            Pane B and the divider stay GONE until split view is enabled.
            WebViews are added to the pane containers at index 0 (below the indicator).
        -->
        <LinearLayout
            android:id="@+id/split_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/pane_a_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <View
                    android:id="@+id/indicator_a"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_gravity="top"
                    android:background="@color/chrome_accent"
                    android:visibility="invisible" />
            </FrameLayout>

            <!-- Drag handle between the two panes: grab it to resize, double-tap to reset to 50/50 -->
            <FrameLayout
                android:id="@+id/split_divider"
                android:layout_width="14dp"
                android:layout_height="match_parent"
                android:background="@color/chrome_omnibox_bg"
                android:contentDescription="@string/split_resize"
                android:visibility="gone">

                <View
                    android:id="@+id/split_handle"
                    android:layout_width="4dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_split_handle" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/pane_b_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone">

                <View
                    android:id="@+id/indicator_b"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_gravity="top"
                    android:background="@color/chrome_accent"
                    android:visibility="invisible" />
            </FrameLayout>
        </LinearLayout>

        <!-- Show / hide toolbar: small button under the toolbar, on the left -->
        <ImageButton
            android:id="@+id/btn_toolbar_toggle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:alpha="0.9"
            android:background="@drawable/bg_toolbar_toggle"
            android:contentDescription="@string/cd_hide_toolbar"
            android:elevation="6dp"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_up"
            app:tint="@color/chrome_text_primary" />
    </FrameLayout>
</LinearLayout>
