<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Dialogs: big rounded corners, raised surface ===== -->
    <style name="ShapeAppearance.BoxWeb.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="MaterialAlertDialog.BoxWeb" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearance">@style/ShapeAppearance.BoxWeb.Dialog</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <style name="MaterialAlertDialog.BoxWeb.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="ThemeOverlay.BoxWeb.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.BoxWeb</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.BoxWeb.Title</item>
        <item name="colorSurface">@color/chrome_surface_elevated</item>
    </style>

    <!-- ===== Snackbar: floating rounded pill ===== -->
    <style name="Widget.BoxWeb.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:background">@drawable/bg_snackbar</item>
        <item name="android:layout_margin">12dp</item>
    </style>

    <!-- ===== Overflow menu popup animation ===== -->
    <style name="MenuPopupAnimation">
        <item name="android:windowEnterAnimation">@anim/menu_enter</item>
        <item name="android:windowExitAnimation">@anim/menu_exit</item>
    </style>

</resources>
